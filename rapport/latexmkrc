# XeLaTeX, with -shell-escape for minted (code highlighting with Pygments)
$pdf_mode = 5;
$xelatex = 'xelatex -shell-escape -interaction=nonstopmode -halt-on-error -file-line-error %O %S';
@default_files = ('rapport.tex');
# Pygments style "vscode" (VS Code Dark+ colours), found through its entry point
use Cwd;
$ENV{'PYTHONPATH'} = getcwd() . '/pygments-vscode' . (defined $ENV{'PYTHONPATH'} ? ':' . $ENV{'PYTHONPATH'} : '');
