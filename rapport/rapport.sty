% ---------------------------------------------------------------- captures
% \capture{fichier.png}{Une ou deux phrases.}
% \capture[0.6]{fichier.png}{...}   capture moins large (petite image, aplats)
% Toutes les captures ont la même règle : pleine largeur, centrées, sans dépasser
% 58 % de la hauteur de page. Si une capture ne tient pas de peu dans la place
% qui reste en bas de page, elle est réduite (jusqu'à 70 % de sa hauteur) au lieu
% de partir à la page suivante en laissant un grand blanc.
\captionsetup{font=small,labelfont=bf,labelsep=period,justification=centering,skip=5pt,hypcap=false}
\newsavebox{\rapport@img}
\newlength{\rapport@reste}
\newcommand{\capture}[3][1]{%
  % pénalité infinie : pas de coupure entre la capture et ce qui l'annonce, et
  % \pagetotal est à jour pour mesurer la place qui reste
  \par\penalty\@M\medskip
  \sbox{\rapport@img}{\includegraphics[width=\dimexpr#1\linewidth-0.8pt\relax,height=0.58\textheight,keepaspectratio]{#2}}%
  \ifdim\pagegoal<\maxdimen
    \setlength{\rapport@reste}{\dimexpr\pagegoal-\pagetotal-3\baselineskip\relax}%
    \ifdim\ht\rapport@img>\rapport@reste
      \ifdim\rapport@reste>0.7\ht\rapport@img
        \sbox{\rapport@img}{\includegraphics[width=\dimexpr#1\linewidth-0.8pt\relax,height=\rapport@reste,keepaspectratio]{#2}}%
      \fi
    \fi
  \fi
  \begin{minipage}{\linewidth}\centering
    {\setlength{\fboxsep}{0pt}\setlength{\fboxrule}{0.4pt}%
     \fcolorbox{black!25}{white}{\usebox{\rapport@img}}}%
    \captionof{figure}{#3}
  \end{minipage}\par\medskip}

% ---------------------------------------------------------------- commandes
% Une commande par puce, dans l'ordre où je les ai lancées :
% \begin{commandes}
%   \cmd{docker compose up -d}
%   \cmd{curl -X POST -d vote=a http://localhost:8080/} (3 fois)
% \end{commandes}
% Caractères spéciaux échappés (\$, \#, \%, \_, \{, \}, \textbackslash{}) ;
% une commande trop longue continue sur la ligne suivante, comme du texte.
% Pas de saut de page dans une liste de moins de 5 commandes ; dans une plus
% longue, jamais une commande seule en haut ou en bas de page. La liste reste
% collée à la phrase qui l'annonce ; après elle, un saut de page reste possible
% (le coller aussi à la capture qui suit laissait de grands blancs).
% La liste est d'abord parcourue une fois, sans rien afficher, pour compter ses
% commandes.
\newcount\rapport@ncmd
\newcount\rapport@icmd
\NewDocumentEnvironment{commandes}{+b}%
  {\global\rapport@ncmd\z@
   \setbox\z@\vbox{\def\cmd##1{\global\advance\rapport@ncmd\@ne}#1}%
   \global\rapport@icmd\z@
   \begin{itemize}[nosep, topsep=3pt, partopsep=0pt, beginpenalty=10000, after=\vspace{2pt}]\raggedright
   #1
   \end{itemize}}%
  {}
\newcommand{\cmd}[1]{%
  \global\advance\rapport@icmd\@ne
  \ifnum\rapport@ncmd<5 \@itempenalty\@M
  \else\ifnum\rapport@icmd=\tw@ \@itempenalty\@M
  \else\ifnum\rapport@icmd=\rapport@ncmd \@itempenalty\@M
  \else \@itempenalty\z@ \fi\fi\fi
  \item \texttt{#1}}

% ---------------------------------------------------------------- fichiers
% \begin{fichier} ... \end{fichier}          extrait YAML
% \begin{fichier}[docker] ... \end{fichier}  autre langage
% Couleurs du thème « Dark+ » de VS Code : style Pygments « vscode » fourni dans
% pygments-vscode/ (latexmkrc l'ajoute au PYTHONPATH).
% Pas de retour à la ligne automatique dans les extraits : le journal signale
% tout dépassement (Overfull \hbox).
\definecolor{vsfond}{HTML}{1E1E1E}
\definecolor{vstexte}{HTML}{D4D4D4}
\definecolor{vsbord}{HTML}{3C3C3C}
\tcbset{
  codebox/.style={enhanced, listing only, colback=vsfond, colupper=vstexte,
    colframe=vsbord, boxrule=0.5pt, arc=2pt, outer arc=2pt, left=8pt, right=6pt,
    top=4pt, bottom=4pt, after skip=8pt,
    % le bloc reste collé à la phrase qui l'annonce
    before={\par\nopagebreak\vspace{\dimexpr 6pt-\parskip\relax}\noindent}},
}
% « !O » : le langage optionnel doit suivre \begin{fichier} sur la même ligne
% (sinon une première ligne commençant par [ serait lue comme argument)
\NewTCBListing{fichier}{ !O{yaml} }{codebox,
  listing engine=minted, minted language=#1, minted style=vscode,
  minted options={fontsize=\small, autogobble}}

% ---------------------------------------------------------------- problème rencontré
% \probleme{ce qui n'allait pas, puis ce que j'ai fait.}
\newcommand{\probleme}[1]{\par\smallskip\textbf{Problème rencontré :} #1\par\smallskip}

% ---------------------------------------------------------------- texte
% \code{nom_de_service}  : texte en police fixe (pas de % ni de # dedans)
\newcommand{\code}[1]{\texttt{\detokenize{#1}}}
